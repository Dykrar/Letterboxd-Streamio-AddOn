# --- Letterboxd ---
# Your Letterboxd username. Your profile, watchlist and diary must be public.
LETTERBOXD_USERNAME=

# --- Sync back to Letterboxd (optional, off by default: the addon then only shows your lists) ---
SYNC_ENABLED=false

# --- Stremio, only needed when SYNC_ENABLED=true (get it with `npm run stremio:login`, see README) ---
STREMIO_AUTH_KEY=

# --- Server ---
# 7001 so it can run next to the MAL addon on 7000
PORT=7001
# Optional: when set, /sync, /refresh and /export.csv require ?token=<ADMIN_TOKEN>. Set this when deployed publicly.
ADMIN_TOKEN=

# --- Sync ---
SYNC_INTERVAL_MINUTES=3
WATCHED_THRESHOLD=0.85
# Keep true until you have checked the dry-run log. Dry runs write nothing but data/sync-state.dry-run.json.
DRY_RUN=true
# false: the first run remembers your existing Stremio history and only exports watches from then on.
SYNC_BACKFILL=false
# Safety cap: max diary rows added per sync run
MAX_EXPORTS_PER_RUN=10
# Your timezone, so diary dates match your calendar day (e.g. Europe/Lisbon)
TZ=

# --- Caching ---
LIST_CACHE_MINUTES=15
